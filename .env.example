# Server Port and Environment
PORT=5000
NODE_ENV=development

# Database Configuration:
# For instant local development in VS Code (zero setup):
DATABASE_URL="file:./dev.db"

# For Vercel Production Deployment (Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL="postgresql://postgres:password@ep-cool-db-123456.us-east-1.aws.neon.tech/digital_inventory?sslmode=require"

# JWT Authentication Secret (Must be at least 32 characters)
JWT_SECRET="kirana-inventory-enterprise-ultra-secure-jwt-key-2026-min-32-chars"
JWT_EXPIRES_IN="7d"

# Cookie Configuration (Leave empty domain for localhost)
COOKIE_DOMAIN=""
COOKIE_SECURE="false"

# Allowed Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Optional Email SMTP (for password reset emails)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@kirana.com"
